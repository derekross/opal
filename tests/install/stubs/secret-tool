#!/bin/sh
# Items live in $FAKE_SECRETS, one per line: "<kind> <id>".
echo "secret-tool $*" >> "${FAKE_LOG:-/dev/null}"
f="${FAKE_SECRETS:-/dev/null}"
case "$1" in
  search) [ -f "$f" ] && while read -r k i; do printf '[/org/freedesktop/secrets/item/%s]\nattribute.kind = %s\n' "$i" "$k"; done < "$f"; exit 0 ;;
  clear) [ "${FAKE_SECRET_RC:-0}" = 0 ] || exit "$FAKE_SECRET_RC"
         kind=$5; [ -f "$f" ] && { grep -v "^$kind " "$f" > "$f.new" || true; mv "$f.new" "$f"; }; exit 0 ;;
esac
exit 0
